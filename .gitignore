# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# all dot-directories (tooling, build output, agent state) at any level
.*/

# opencode agent tooling (local renders, extracted Figma assets, screenshots)
.opencode/
.playwright-mcp/
opencode.json
screenshots-small/

# deployment scripts — live on the `deploy` branch only
apache/
deploy/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules/
dist/
.env

# intlayer build output (generated)
.intlayer/

# prisma local state (generated)
.prisma/

